# Backend API URL
# This is the URL of your backend server
# For local development, use http://localhost:5000
# For production, use https://money-mint-backend.vercel.app
VITE_BASE_URL=http://localhost:5000

# Google OAuth Client ID (public, safe to expose in the browser)
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
# Must be the same value as GOOGLE_CLIENT_ID in Backend/.env
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
