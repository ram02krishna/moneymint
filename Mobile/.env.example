# Same backend as the web app. Pick ONE:
# Android emulator talking to a backend running on your PC:
EXPO_PUBLIC_API_URL=http://10.0.2.2:5000
# Physical phone on the same Wi-Fi (replace with your PC's LAN IP):
# EXPO_PUBLIC_API_URL=http://192.168.1.10:5000
# Deployed backend (recommended for release builds, must be HTTPS):
# EXPO_PUBLIC_API_URL=https://your-backend.vercel.app
