# MoneyMint Mobile Configuration
# Deployed backend (accessible over any Wi-Fi network and mobile data):
EXPO_PUBLIC_API_URL=https://money-mint-backend.vercel.app

# Google Web Client ID (from Google Cloud Console, matching Backend GOOGLE_CLIENT_ID)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com

# Optional local development overrides:
# Android emulator: EXPO_PUBLIC_API_URL=http://10.0.2.2:5000
# Physical phone on same Wi-Fi: EXPO_PUBLIC_API_URL=http://192.168.1.10:5000
